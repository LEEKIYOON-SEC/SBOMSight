<?xml version="1.0" encoding="UTF-8"?>
<!--
  SBOMSight — SBOM 기반 취약점 대응 검토

  Syft 가 만든 SBOM 을 올리면 Grype 이 돌고, 그 결과를 자산별로 쌓아
  이력과 조치를 관리한다. Syft·Grype 이 판정의 전부이고 이 애플리케이션은
  그 결과를 보관·정렬·집계할 뿐이다.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.13</version>
    <relativePath/>
  </parent>

  <groupId>kr.sbomsight</groupId>
  <artifactId>sbomsight</artifactId>
  <version>1.0.0</version>
  <name>SBOMSight</name>
  <description>SBOM 기반 취약점 대응 검토</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- ══ grype 이 우리 jar 에서 찾아낸 것을 올린다 ═══════════════════════════
         이 도구로 이 도구를 검사해서 나온 것들이다. 자기 자신의 심각 건을
         두고 남의 서버를 점검하는 것은 말이 되지 않는다.

           scripts/make-notice.sh 로 SBOM 을 뽑고
           grype sbom:target/sbomsight.cdx.json

         스프링 부트 3.3.13 이 3.3.x 의 마지막 판이라 관리 버전이 여기서 더
         올라가지 않는다. 그래서 **grype 이 수정 버전을 명시한 셋만** 속성으로
         올려 둔다 — 스프링 부트가 문서로 허용하는 방식이고, 셋 다 같은
         라이브러리 계열 안에서 올라간다.

         **판올림할 때 이 셋을 먼저 지운다.** 부모가 더 높은 판을 들고 오면
         여기 고정된 낮은 값이 오히려 내리는 값이 된다. -->
    <tomcat.version>10.1.49</tomcat.version>      <!-- 3.3.13: 10.1.42 -->
    <logback.version>1.5.25</logback.version>     <!-- 3.3.13: 1.5.18 -->
    <jackson-bom.version>2.18.6</jackson-bom.version>  <!-- 3.3.13: 2.17.3 -->
  </properties>

  <dependencies>
    <!-- 내장 Tomcat + Spring MVC. HTTPS 는 application.yml 의 server.ssl 로 켠다. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 화면은 서버에서 그린다. 로그인·세션이 브라우저 자바스크립트와 어긋나
         "로그인은 되는데 화면이 안 열리는" 상태를 만들지 않기 위해서다. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <!-- 로그인·세션·CSRF·권한. 직접 짜지 않는다. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 스키마는 Flyway 가 버전으로 관리한다. 운영 DB 를 지우고 다시 만들라고
         할 수 없으므로 ddl-auto 는 쓰지 않는다. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- JDBC 드라이버. MariaDB 와 MySQL 8 둘 다 붙는다.
         (MySQL 8 의 기본 인증 caching_sha2_password 는 2.5.0 부터 지원)

         왜 mysql-connector-j 가 아닌가 — 그쪽은 GPL-2.0 이다. FOSS 예외가
         붙어 있지만 그 예외는 승인된 오픈소스 라이선스로 배포할 때만 듣는다.
         이쪽은 LGPL-2.1 이라 jar 를 그대로 두는 한(교체 가능) 우리 코드에
         옮지 않는다. 사내 전용이면 어느 쪽이든 의무가 없지만, 나중에 밖으로
         낼 일이 생겼을 때 걸리는 자리를 미리 없앤다. -->
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 테스트는 파일 하나로 끝나는 DB 를 쓴다. 스키마는 Flyway 가 MySQL 과
         같은 마이그레이션을 그대로 태운다(MODE=MySQL). -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!--
      시험은 `src/test` 가 아니라 **최상위 `tests/`** 에 둔다.

      왜. 운영 PC 는 소스를 받아 그 자리에서 빌드한다(docs/windows-setup.md).
      시험이 `src/test` 에 있으면 운영 PC 디스크에 시험 코드가 남고, 점검에서
      "운영 시스템에 시험 코드가 있다" 로 잡힌다. 실행되지는 않지만 그 자리에
      있다는 것이 지적 사항이다.

      한 폴더에 모아 두면 **운영 PC 에서 `tests` 하나만 지우면 끝난다** —
      시험 코드·시험 자원·시험 스크립트가 전부 그 안에 있다. 저장소에는
      그대로 남으므로 시험 증적을 잃지 않는다.

      **없어도 빌드는 된다.** 폴더가 없으면 testCompile 이 할 일이 없어
      그냥 지나간다 — 운영 PC 에서 지운 뒤에도 `mvnw package` 가 돈다.
    -->
    <testSourceDirectory>${project.basedir}/tests/java</testSourceDirectory>
    <testResources>
      <testResource>
        <directory>${project.basedir}/tests/resources</directory>
      </testResource>
    </testResources>

    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
