<?xml version="1.0" encoding="UTF-8"?>
<!--
  SBOMSight — SBOM 기반 취약점 대응 검토

  Syft 가 만든 SBOM 을 올리면 Grype 이 돌고, 그 결과를 자산별로 쌓아
  이력과 조치를 관리한다. Syft·Grype 이 판정의 전부이고 이 애플리케이션은
  그 결과를 보관·정렬·집계할 뿐이다.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>kr.sbomsight</groupId>
  <artifactId>sbomsight</artifactId>
  <version>1.0.0</version>
  <name>SBOMSight</name>
  <description>SBOM 기반 취약점 대응 검토</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- 내장 Tomcat + Spring MVC. HTTPS 는 application.yml 의 server.ssl 로 켠다. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 화면은 서버에서 그린다. 로그인·세션이 브라우저 자바스크립트와 어긋나
         "로그인은 되는데 화면이 안 열리는" 상태를 만들지 않기 위해서다. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <!-- 로그인·세션·CSRF·권한. 직접 짜지 않는다. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 스키마는 Flyway 가 버전으로 관리한다. 운영 DB 를 지우고 다시 만들라고
         할 수 없으므로 ddl-auto 는 쓰지 않는다. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- JDBC 드라이버. MariaDB 와 MySQL 8 둘 다 붙는다.
         (MySQL 8 의 기본 인증 caching_sha2_password 는 2.5.0 부터 지원)

         왜 mysql-connector-j 가 아닌가 — 그쪽은 GPL-2.0 이다. FOSS 예외가
         붙어 있지만 그 예외는 승인된 오픈소스 라이선스로 배포할 때만 듣는다.
         이쪽은 LGPL-2.1 이라 jar 를 그대로 두는 한(교체 가능) 우리 코드에
         옮지 않는다. 사내 전용이면 어느 쪽이든 의무가 없지만, 나중에 밖으로
         낼 일이 생겼을 때 걸리는 자리를 미리 없앤다. -->
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 테스트는 파일 하나로 끝나는 DB 를 쓴다. 스키마는 Flyway 가 MySQL 과
         같은 마이그레이션을 그대로 태운다(MODE=MySQL). -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
