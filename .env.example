# SBOMSight 설정 예시 — 이 파일을 .env로 복사해 쓰세요.
# 기본값은 AI를 사용하지 않는 상태(Mode B)입니다. AI 없이도 전체 파이프라인이
# 동작하며, 리포트도 완결됩니다.

# --- 외부 도구 -----------------------------------------------------------
# SYFT_BIN=/home/user/.local/bin/syft
# GRYPE_BIN=/home/user/.local/bin/grype
# SBOMSIGHT_TOOL_TIMEOUT=900

# --- 데이터 --------------------------------------------------------------
# 스캔 결과에는 내부 자산 정보가 담깁니다. 이 디렉터리는 커밋 대상이 아닙니다.
# SBOMSIGHT_DATA_DIR=./data

# --- 오프라인 운영 -------------------------------------------------------
# 1로 두면 Grype DB 자동 갱신을 시도하지 않고 마지막 스냅샷으로만 동작합니다.
# SBOMSIGHT_OFFLINE=0
# SBOMSIGHT_ENRICH_TTL_HOURS=24
# SBOMSIGHT_SNAPSHOT_STALE_DAYS=7

# --- 위협정보 소스 -------------------------------------------------------
# NVD_API_KEY=

# --- AI (선택, Mode A) ---------------------------------------------------
# 켜기 전에 알아 두세요: AI에는 공개 취약점 데이터(VulnFact)만 전달됩니다.
# 자산명·호스트명·IP·경로·설치 버전·SBOM 목록은 구조적으로 전달될 수 없습니다.
# SBOMSIGHT_AI_ENABLED=0
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- 서버 ----------------------------------------------------------------
# SBOMSIGHT_HOST=127.0.0.1
# SBOMSIGHT_PORT=8000
