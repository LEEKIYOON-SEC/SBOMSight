# SBOMSight 설정 예시 — 이 파일을 .env로 복사해 쓰세요.
#
# 기본값은 AI를 사용하지 않는 상태(Mode B)입니다. AI 없이도 전체 파이프라인이
# 동작하며 보고서도 완결됩니다. AI는 ②기술적 위험성과 ④대응 필요성 분석의
# 서술을 더 읽기 좋게 바꾸는 선택 기능일 뿐입니다.

# --- 외부 도구 -----------------------------------------------------------
# PATH에 없으면 경로를 지정하세요. 폐쇄망에서는 바이너리를 미리 반입합니다.
# SYFT_BIN=/home/user/.local/bin/syft
# GRYPE_BIN=/home/user/.local/bin/grype
# SBOMSIGHT_TOOL_TIMEOUT=900

# --- 데이터 --------------------------------------------------------------
# 업로드된 SBOM과 스캔 결과에는 내부 자산 정보가 담깁니다.
# 이 디렉터리는 .gitignore 대상이며 백업·반출 시 승인 대상이 됩니다.
# SBOMSIGHT_DATA_DIR=./data
# SBOMSIGHT_DB_PATH=./data/sbomsight.db

# --- 오프라인 운영 -------------------------------------------------------
# 1로 두면 네트워크를 쓰지 않고 반입한 스냅샷으로만 동작합니다.
# Grype에도 GRYPE_DB_AUTO_UPDATE=false 를 자동으로 넘깁니다.
# 확보하지 못한 위협정보는 unknown 으로 남고 보고서에 그렇게 표기됩니다 —
# 0으로 채우거나 "없음"으로 처리하지 않습니다.
# 자세한 절차: docs/offline-operations.md
# SBOMSIGHT_OFFLINE=0
# SBOMSIGHT_ENRICH_TTL_HOURS=24
# SBOMSIGHT_SNAPSHOT_STALE_DAYS=7      # 이보다 오래되면 stale_snapshot 표기

# Grype 자체 설정 (오프라인 반입 시)
# GRYPE_DB_AUTO_UPDATE=false
# GRYPE_CHECK_FOR_APP_UPDATE=false
# GRYPE_DB_CACHE_DIR=/home/user/.cache/grype/db
# GRYPE_DB_MAX_ALLOWED_BUILT_AGE=720h

# --- 위협정보 소스 -------------------------------------------------------
# NVD는 CWE 보강에만 씁니다. 키가 없어도 동작하나 레이트리밋이 빡빡합니다
# (키 없이 30초당 5건). 확보하지 못한 CVE는 CWE 없이 남습니다.
# 선택 수집기 — **기본은 전부 꺼짐**입니다.
#
# EPSS·KEV 는 Grype 가 판정(CVSS·수정 상태)과 같은 출처에서 함께 줍니다.
# 남는 것은 "공격코드가 공개되어 있다"는 신호 하나입니다.
#
#   Exploit-DB   GPL-2.0 (copyleft) — 사내 반입·배포 기준 확인이 필요합니다
#   Metasploit   BSD 3-Clause 계열 — 출처 고지 권장
#
# 켜지 않아도 우선순위 판정은 KEV·EPSS·CVSS 로 성립합니다. 끈 소스가 담당하던
# 신호는 '없음'이 아니라 '미확인'으로 남습니다.
# SBOMSIGHT_COLLECT_EXPLOITDB=0
# SBOMSIGHT_COLLECT_METASPLOIT=0

# NVD_API_KEY=
# EPSS_CSV_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
# KEV_JSON_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- AI (선택, Mode A) ---------------------------------------------------
# 켜기 전에 알아 두세요:
#   · AI에는 공개 취약점 데이터(VulnFact)만 전달됩니다.
#   · 자산명·호스트명·IP·경로·설치 버전·취약 여부 판정·대응 우선순위는
#     조립 함수의 시그니처가 받지 않으므로 구조적으로 전달될 수 없습니다.
#   · 전송 대상은 담당자가 결과 표에서 체크한 항목뿐입니다. 체크하지 않은
#     취약점은 조립 단계에 들어가지도 않습니다.
#   · 전송 전에 웹 UI의 "AI에 전송될 내용 보기"로 전문을 확인하고, 그 화면에서
#     직접 전송을 시작합니다. 확인한 것과 전송되는 것이 같은 조립기·같은 범위입니다.
#   · 모든 전송 시도는 성공·차단 모두 data/audit/ 에 payload 원문·SHA-256과
#     함께 기록됩니다.
#   · 대응 검토 우선순위는 로컬 룰 엔진의 산출물이며 AI가 바꾸지 못합니다.
#
# 키는 이 파일(서버 프로세스의 환경변수)에만 둡니다. 브라우저로 내려가지 않고,
# 방문자에게 입력받지도 않으며, 호출은 전부 서버에서 나갑니다.
# 키 발급: https://aistudio.google.com/apikey
# SBOMSIGHT_AI_ENABLED=0
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# 폴백은 비워 두는 것이 기본입니다. primary와 같은 모델을 넣으면 쿼터가
# 소진됐을 때 같은 문을 한 번 더 두드릴 뿐입니다.
# GEMINI_FALLBACK_MODEL=
# GEMINI_TIMEOUT=120
# GEMINI_MAX_RETRIES=3

# --- 서버 ----------------------------------------------------------------
# 기본 바인딩은 127.0.0.1 입니다. 스캔 결과에는 내부 자산 정보가 담기므로
# 외부 노출은 명시적으로 바꿔야만 일어나며, 그때 경고가 표시됩니다.
# 계정이 하나도 없으면 외부 바인딩을 거부합니다.
# SBOMSIGHT_HOST=127.0.0.1
# SBOMSIGHT_PORT=8000
# 실 서버 한 대의 SBOM 이 100MB 를 넘습니다. 파일을 통째로 메모리에 올리지
# 않으므로 이 값이 커도 메모리 사용량은 청크 하나(1MB)에 머뭅니다.
# SBOMSIGHT_MAX_UPLOAD_MB=10240
# 보관 시 gzip 압축 (실측 25배 이상 줄어듭니다)
# SBOMSIGHT_COMPRESS_STORAGE=1

# --- 접근 통제 ------------------------------------------------------------
# 접속을 허용할 IP·CIDR (쉼표 구분). **부트스트랩 값입니다** — 웹의
# `설정 → 접근 IP` 에서 한 번이라도 저장하면 그때부터 DB 값이 쓰입니다.
# 비어 있으면 IP 제한 없음이며, 로그인은 여전히 필요합니다.
# 판단은 소켓 상대 주소로만 하고 X-Forwarded-For 헤더는 보지 않습니다.
# SBOMSIGHT_ALLOWED_IPS=192.168.10.0/24,10.0.0.5
# 로그인 세션 유효 시간
# SBOMSIGHT_SESSION_TTL_HOURS=12
